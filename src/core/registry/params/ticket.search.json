{
  "params": [
    {
      "name": "appKey",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "企业的appKey",
      "example": "{{appKey}}"
    },
    {
      "name": "time",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "当前 UTC 时间戳，从 1970 年 1 月 1 日 0 点 0 分 0 秒开始到现在的秒数,1463217187",
      "example": "{{time}}"
    },
    {
      "name": "checksum",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "SHA1(appSecret + md5 + time), 三个参数拼接的字符串，进行SHA1哈希计算，转化成16进制字符(String，小写).示例2f13932c4b7c6888b12360a85261a11b8b543f64 ",
      "example": "{{checksum}} "
    },
    {
      "name": "ticketId",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "工单ID"
    },
    {
      "name": "mobile",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "用户手机号"
    },
    {
      "name": "limit",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "一次请求获取的工单数上限，最大为50"
    },
    {
      "name": "offset",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "偏移量"
    },
    {
      "name": "sortBy",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "排序方式，默认为\"ct\"创建时间"
    },
    {
      "name": "order",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "升降序，默认desc，降序"
    },
    {
      "name": "start",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "起始毫秒时间戳（若不传该参数，则默认支持时间跨度为30天）"
    },
    {
      "name": "end",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "截止毫秒时间戳"
    },
    {
      "name": "opStart",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "操作时间起始毫秒时间戳"
    },
    {
      "name": "opEnd",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "操作时间截止毫秒时间戳（不超过90天）"
    },
    {
      "name": "withCustomField",
      "in": "body",
      "required": false,
      "type": "boolean",
      "description": "是否包含自定义字段信息"
    },
    {
      "name": "uid",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "访客的foreignid"
    }
  ],
  "responseShape": {
    "kind": "object"
  },
  "bodyKind": "json"
}

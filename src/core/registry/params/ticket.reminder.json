{
  "params": [
    {
      "name": "appKey",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "企业的appKey",
      "example": "{{appKey}}"
    },
    {
      "name": "time",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "当前 UTC 时间戳，从 1970 年 1 月 1 日 0 点 0 分 0 秒开始到现在的秒数,1463217187",
      "example": "{{time}}"
    },
    {
      "name": "checksum",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "SHA1(appSecret + md5 + time), 三个参数拼接的字符串，进行SHA1哈希计算，转化成16进制字符(String，小写).示例2f13932c4b7c6888b12360a85261a11b8b543f64 ",
      "example": "{{checksum}} "
    },
    {
      "name": "ticketId",
      "in": "body",
      "required": true,
      "type": "integer",
      "description": "工单ID"
    },
    {
      "name": "staffId",
      "in": "body",
      "required": true,
      "type": "integer",
      "description": "发起催单客服的ID"
    },
    {
      "name": "comment",
      "in": "body",
      "required": true,
      "type": "string",
      "description": "催单内容"
    },
    {
      "name": "attachments",
      "in": "body",
      "required": false,
      "type": "array",
      "description": "催单附件"
    }
  ],
  "responseShape": {
    "kind": "object"
  },
  "bodyKind": "json"
}

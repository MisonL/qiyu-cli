{
  "name": "qiyu-cli",
  "version": "0.2.3",
  "description": "网易七鱼开放 API 的命令行封装，主要用户是 AI Agent：默认输出机器可读 JSON，用退出码表达意图，危险操作有硬门禁",
  "type": "module",
  "license": "MIT",
  "author": "MisonL",
  "homepage": "https://github.com/MisonL/qiyu-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisonL/qiyu-cli.git"
  },
  "bugs": {
    "url": "https://github.com/MisonL/qiyu-cli/issues"
  },
  "keywords": [
    "qiyu",
    "七鱼",
    "网易七鱼",
    "cli",
    "api",
    "agent",
    "ai-agent",
    "customer-service"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "qiyu": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepare": "npm run build",
    "postinstall": "node -e \"const f=require('node:fs'),c=require('node:child_process'),p='dist/postinstall.js';if(f.existsSync(p))try{c.execFileSync(process.execPath,[p],{stdio:'inherit'})}catch{}\" || exit 0",
    "test": "node scripts/test-shards.mjs",
    "test:single": "vitest run --maxWorkers=1 --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fflate": "^0.8.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "2.9.1"
  },
  "optionalDependencies": {
    "@duckdb/node-api": "1.5.6-r.1"
  }
}

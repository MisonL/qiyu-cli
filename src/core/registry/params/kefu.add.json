{
  "params": [
    {
      "name": "appKey",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "企业的appKey",
      "example": "{{appKey}}"
    },
    {
      "name": "time",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "当前 UTC 时间戳，从 1970 年 1 月 1 日 0 点 0 分 0 秒开始到现在的秒数,1463217187",
      "example": "{{time}}"
    },
    {
      "name": "checksum",
      "in": "query",
      "required": true,
      "type": "string",
      "description": "SHA1(appSecret + md5 + time), 三个参数拼接的字符串，进行SHA1哈希计算，转化成16进制字符(String，小写).示例2f13932c4b7c6888b12360a85261a11b8b543f64 ",
      "example": "{{checksum}} "
    },
    {
      "name": "username",
      "in": "body",
      "required": true,
      "type": "string",
      "description": "客服账号，仅支持数字、字母、下划线、圆点，首字母必须是字母，不超过40个长度"
    },
    {
      "name": "password",
      "in": "body",
      "required": true,
      "type": "string",
      "description": "客服密码，需要使用md5加密算法加密后转小写，长度是32位，不能包含'-'字符"
    },
    {
      "name": "role",
      "in": "body",
      "required": true,
      "type": "integer",
      "description": "角色种类 0 普通客服，1 管理员，-1 工单客服，-2 呼叫客服"
    },
    {
      "name": "subRoleId",
      "in": "body",
      "required": true,
      "type": "integer",
      "description": "角色id，目前只能通过浏览器的开发者工具查看获得。请以管理员角色登录七鱼后，点击左侧导航树\"客服管理\"菜单，在打开的页面上点击\"角色设置\"选项卡， 对应的请求url为 api/kefuSet/list/get"
    },
    {
      "name": "realname",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "用户名称，不超过40个长度"
    },
    {
      "name": "nickname",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "昵称，不超过40个长度"
    },
    {
      "name": "pinyin",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "客服名称拼音"
    },
    {
      "name": "mobile",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "用户电话"
    },
    {
      "name": "email",
      "in": "body",
      "required": false,
      "type": "string",
      "description": "用户邮件"
    },
    {
      "name": "maxSession",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "客服最大接待数"
    },
    {
      "name": "groupIds",
      "in": "body",
      "required": false,
      "type": "array",
      "description": "客服分组id数组，是数组[]，不是字符串"
    },
    {
      "name": "callEnable",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "是否有电话权限， 0 否 1 有"
    },
    {
      "name": "skillScoreChat",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "在线会话技能值(0-10)"
    },
    {
      "name": "skillScoreIpcc",
      "in": "body",
      "required": false,
      "type": "integer",
      "description": "电话技能值(0-10)"
    }
  ],
  "responseShape": {
    "kind": "object"
  },
  "bodyKind": "xml"
}
